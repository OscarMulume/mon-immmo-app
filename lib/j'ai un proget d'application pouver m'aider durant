import { useState } from 'react';

import { supabase } from '@/lib/supabase';



export default function ImageUpload({ onUpload }: { onUpload: (urls: string[]) => void }) {

const [uploading, setUploading] = useState(false);



const handleUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {

try {

setUploading(true);

if (!e.target.files || e.target.files.length === 0) return;



const files = Array.from(e.target.files);

const publicUrls: string[] = [];



for (const file of files) {

// Créer un nom de fichier unique pour éviter les doublons

const fileExt = file.name.split('.').pop();

const fileName = `${Math.random()}.${fileExt}`;

const filePath = `${fileName}`;



// 1. Envoyer le fichier au bucket 'listing-images'

const { error: uploadError } = await supabase.storage

.from('listing-images')

.upload(filePath, file);



if (uploadError) throw uploadError;



// 2. Récupérer l'URL publique générée par Supabase

const { data } = supabase.storage

.from('listing-images')

.getPublicUrl(filePath);



publicUrls.push(data.publicUrl);

}



// Envoyer la liste des URLs au composant parent (le formulaire)

onUpload(publicUrls);

alert("Images enregistrées !");

} catch (error: any) {

alert("Erreur d'upload : " + error.message);

} finally {

setUploading(false);

}

};



return (

